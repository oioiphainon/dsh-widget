{
  "name": "@local/dsh-fat-fish-widget",
  "version": "0.4.2",
  "private": true,
  "description": "桌面工鱼（Desk Fish）:一只常驻 Windows 桌面的悬浮小鱼,始终置顶显示当前 DSH 会话的轮次、步骤、工具调用、todo、后台任务与团队任务;可自选开机自启、关闭 DSH 后是否保留,右键可隐藏/托盘一键找回。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "desktop",
    "widget",
    "progress",
    "mascot"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oioiphainon/dsh-widget.git"
  },
  "homepage": "https://github.com/oioiphainon/dsh-widget#readme",
  "bugs": {
    "url": "https://github.com/oioiphainon/dsh-widget/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "screenshots.json",
    "README.md",
    "desktop/FatFishDesktop.ps1",
    "desktop/strings.json",
    "desktop/fish.png",
    "desktop/launch-widget.vbs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
