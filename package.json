{
  "name": "@local/dsh-fat-fish-widget",
  "version": "0.4.1",
  "private": true,
  "description": "大肥鱼桌面挂件:一只常驻 Windows 桌面的悬浮鱼娘,始终置顶显示当前会话的轮次、步骤、工具调用、todo、后台任务与团队任务;可自选开机自启与关闭 DSH 后是否保留。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "desktop",
    "widget",
    "progress",
    "mascot"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danheng383-commits/dsh-widget.git"
  },
  "homepage": "https://github.com/danheng383-commits/dsh-widget#readme",
  "bugs": {
    "url": "https://github.com/danheng383-commits/dsh-widget/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "screenshots.json",
    "README.md",
    "desktop/FatFishDesktop.ps1",
    "desktop/strings.json",
    "desktop/fish.png",
    "desktop/launch-widget.vbs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
